<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>mapenv.bin doEncrypt coordinate range</name>
    <description><![CDATA[
      doEncrypt coordinate boundary extracted from mapenv.bin.<br/>
      Longitude: 121.15000 to 121.31000<br/>
      Latitude: 31.18000 to 31.21000<br/>
      Center: 121.23000, 31.19500
    ]]></description>

    <Style id="rangeStyle">
      <LineStyle>
        <color>ff0000ff</color>
        <width>3</width>
      </LineStyle>
      <PolyStyle>
        <color>330000ff</color>
        <fill>1</fill>
        <outline>1</outline>
      </PolyStyle>
    </Style>

    <Style id="centerStyle">
      <IconStyle>
        <color>ff00ff00</color>
        <scale>1.1</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/paddle/grn-circle.png</href>
        </Icon>
      </IconStyle>
    </Style>

    <Style id="cornerStyle">
      <IconStyle>
        <color>ff0000ff</color>
        <scale>0.9</scale>
        <Icon>
          <href>http://maps.google.com/mapfiles/kml/paddle/red-circle.png</href>
        </Icon>
      </IconStyle>
    </Style>

    <Placemark>
      <name>doEncrypt valid coordinate rectangle</name>
      <description><![CDATA[
        lon_min=121.15000, lon_max=121.31000<br/>
        lat_min=31.18000, lat_max=31.21000
      ]]></description>
      <styleUrl>#rangeStyle</styleUrl>
      <Polygon>
        <tessellate>1</tessellate>
        <outerBoundaryIs>
          <LinearRing>
            <coordinates>
              121.15000000,31.18000000,0
              121.31000000,31.18000000,0
              121.31000000,31.21000000,0
              121.15000000,31.21000000,0
              121.15000000,31.18000000,0
            </coordinates>
          </LinearRing>
        </outerBoundaryIs>
      </Polygon>
    </Placemark>

    <Placemark>
      <name>Center (121.23000, 31.19500)</name>
      <styleUrl>#centerStyle</styleUrl>
      <Point>
        <coordinates>121.23000000,31.19500000,0</coordinates>
      </Point>
    </Placemark>

    <Placemark>
      <name>Southwest (121.15000, 31.18000)</name>
      <styleUrl>#cornerStyle</styleUrl>
      <Point>
        <coordinates>121.15000000,31.18000000,0</coordinates>
      </Point>
    </Placemark>
    <Placemark>
      <name>Southeast (121.31000, 31.18000)</name>
      <styleUrl>#cornerStyle</styleUrl>
      <Point>
        <coordinates>121.31000000,31.18000000,0</coordinates>
      </Point>
    </Placemark>
    <Placemark>
      <name>Northeast (121.31000, 31.21000)</name>
      <styleUrl>#cornerStyle</styleUrl>
      <Point>
        <coordinates>121.31000000,31.21000000,0</coordinates>
      </Point>
    </Placemark>
    <Placemark>
      <name>Northwest (121.15000, 31.21000)</name>
      <styleUrl>#cornerStyle</styleUrl>
      <Point>
        <coordinates>121.15000000,31.21000000,0</coordinates>
      </Point>
    </Placemark>
  </Document>
</kml>
